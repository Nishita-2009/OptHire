# OptHire Environment Configuration Template
GOOGLE_API_KEY=your_google_api_key_here

# Database Configuration (SQLite default, PostgreSQL compatible)
DATABASE_URL=sqlite:///./opthire.db
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/opthire

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false
ENVIRONMENT=development

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
